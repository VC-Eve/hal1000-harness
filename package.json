{
  "name": "hal1000-harness",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "ui",
    "recogniser"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @hal1000/server",
    "dev:ui": "npm run dev --workspace @hal1000/ui",
    "dev:recogniser": "npm run dev --workspace @hal1000/recogniser",
    "build": "npm run build --workspace @hal1000/ui",
    "start": "npm run start --workspace @hal1000/server",
    "start:recogniser": "npm run start --workspace @hal1000/recogniser",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p recogniser/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
